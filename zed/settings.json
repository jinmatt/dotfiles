// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "preview_tabs": {
    "enabled": false
  },
  "terminal": {
    "font_size": 12.0
  },
  "debugger": {
    "dock": "left",
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_buffer_font_size": 14.0,
  "ui_font_weight": 400.0,
  "ui_font_family": "JetBrains Mono NL",
  "buffer_line_height": "comfortable",
  "search": {
    "center_on_match": false,
  },
  "use_smartcase_search": true,
  "agent": {
    "limit_content_width": true,
    "max_content_width": 950.0,
    "default_width": 1000.0,
    // "max_content_width": 750.0,
    // "default_width": 800.0,
    "sidebar_side": "right",
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
      "enable_thinking": false,
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
      "enable_thinking": false,
    },
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
    "favorite_models": [],
    "single_file_review": false,
    "model_parameters": [],
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
  },
  "tabs": {
    "show_close_button": "hover",
    "file_icons": true,
    "git_status": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
  },
  "status_bar": {
    "active_encoding_button": "non_utf8",
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": false,
    "default_width": 175.0,
    // "default_width": 70.0,
    "dock": "left",
    "indent_size": 13.0,
    // "indent_size": 10.0,
    "entry_spacing": "standard",
  },
  "git": {
    "inline_blame": {
      "delay_ms": 0,
    },
  },
  "buffer_font_weight": 500.0,
  "agent_ui_font_size": 15.0,
  // "agent_ui_font_size": 13.0,
  "relative_line_numbers": "disabled",
  "buffer_font_family": "JetBrains Mono NL",
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 230,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "which_key": {
    "enabled": true,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "amp-acp": {
      "type": "registry",
    },
    "opencode": {
      "favorite_config_option_values": {
        "mode": ["plan"],
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "context_servers": {},
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "Cursor",
  "ui_font_size": 13.0,
  // "ui_font_size": 12.0,
  "buffer_font_size": 13.0,
  // "buffer_font_size": 13.0,
  "theme": "Catppuccin Macchiato",
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
  },
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
  },
}
